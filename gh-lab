#!/usr/bin/env bash
# gh lab <assignment>  —  RAIK183H
# Accepts the assignment (or joins your partner's), adds your partner,
# downloads the code, and opens it. Safe to run again any time.
set -uo pipefail

CLASSROOMS="raik183h-labs/raik-183h-labs RAIK183H-Fall2026/raik-183h"

# Course editor extensions. Checkstyle isn't on Open VSX, so it ships as a file.
EXTENSIONS="specstory.specstory-vscode xyz.local-history redhat.java"
CHECKSTYLE_ID="shengchen.vscode-checkstyle"
CHECKSTYLE_VSIX="https://raw.githubusercontent.com/raik183h-labs/setup/main/CheckstyleForJava.vsix"

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()  { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
die() { bad "$*"; printf '\n  Stuck? Show this message to your instructor or a TA.\n\n'; exit 1; }
lc()  { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

CMD="${RAIK_CMD:-lab}"
SLUG="${1:-}"
if [ -z "$SLUG" ]; then
  printf 'Usage:  gh %s <assignment-name>\n' "$CMD"
  if [ "$CMD" = homework ]; then printf 'Example: gh homework homework-3\n'
  else printf 'Example: gh lab lab-loops-1\n'; fi
  printf '\nStuck? Run:  gh %s --check\n' "$CMD"; exit 1
fi

# Where assignments get downloaded. Set once with `gh lab --here`; kept in git
# config so it works the same in Terminal and Git Bash and survives reinstalls.
course_dir() { git config --global --get raik.coursedir 2>/dev/null; }

if [ "$SLUG" = "--here" ]; then
  say "Course folder"
  if git config --global raik.coursedir "$PWD" 2>/dev/null; then
    ok "$PWD"
    printf '\n  From now on, %s puts every assignment here — no matter\n' "gh $CMD"
    printf '  which folder your terminal is in when you run it.\n\n'
    exit 0
  fi
  die "Couldn't save that. Is git installed?"
fi

if [ "$SLUG" = "--check" ] || [ "$SLUG" = "doctor" ]; then
  say "Setup check"
  printf '  OS ............ %s\n' "$(uname -s 2>/dev/null || echo unknown)"
  if command -v git >/dev/null 2>&1; then ok "git          $(git --version | awk '{print $3}')"
  else bad "git          NOT FOUND  — install it, then close and reopen your terminal"; fi
  if command -v gh  >/dev/null 2>&1; then ok "gh           $(gh --version | head -1 | awk '{print $3}')"
  else bad "gh           NOT FOUND  — install it, then close and reopen your terminal"; fi
  if gh auth status >/dev/null 2>&1; then ok "signed in as $(gh api user --jq .login 2>/dev/null)"
  else bad "not signed in — run:  gh student login"; fi
  if gh student --help >/dev/null 2>&1; then ok "gh student   installed"
  else bad "gh student   missing — it installs itself the first time you run a lab"; fi
  if printf '%s' "$(gh auth status --active 2>&1)" | grep -q "admin:org"; then ok "permissions  ok"
  else bad "permissions  incomplete — run:  gh student login"; fi
  proto="$(gh config get git_protocol -h github.com 2>/dev/null)"
  if [ "$proto" = "ssh" ]; then
    bad "git protocol ssh — labs can't download. Fix with:"
    printf '                 gh config set git_protocol https -h github.com\n'
  else ok "git protocol ${proto:-https}"; fi
  cd_now="$(course_dir)"
  if [ -z "$cd_now" ]; then
    bad "course folder not set — cd to your course folder and run:  gh $CMD --here"
  elif [ -d "$cd_now" ]; then ok "course folder $cd_now"
  else bad "course folder $cd_now (missing — re-run 'gh $CMD --here' somewhere that exists)"; fi
  ED=""
  if   command -v cursor >/dev/null 2>&1; then ED=cursor
  elif command -v code   >/dev/null 2>&1; then ED=code; fi
  if [ -n "$ED" ]; then
    ok "editor       $ED"
    if have="$("$ED" --list-extensions 2>/dev/null | tr 'A-Z' 'a-z')"; then :; else have=""; fi
    if [ -z "$have" ] && ! "$ED" --list-extensions >/dev/null 2>&1; then
      bad "extensions   couldn't ask $ED — open $ED once, then run this again"
    else
      for e in $EXTENSIONS $CHECKSTYLE_ID; do
        label="${e#*.}"
        if printf '%s\n' "$have" | grep -qx "$(lc "$e")"
          then ok "  $(printf '%-24s' "$label") installed"
          else bad "  $(printf '%-24s' "$label") MISSING — it installs when you run your first lab"; fi
      done
    fi
  else
    bad "editor       no 'cursor' command — labs still work, they just won't auto-open"
    bad "extensions   can't check them without the 'cursor' command"
  fi
  for pair in $CLASSROOMS; do
    o="${pair%%/*}"; c="${pair##*/}"
    if curl -fsSL "https://$(lc "$o").github.io/classroom50/$c/assignments.json" >/dev/null 2>&1
      then ok "classroom    $o reachable"; else bad "classroom    can't reach $o — check your internet"; fi
  done
  printf '\n  Show this whole output to your instructor or a TA if something is red.\n\n'
  exit 0
fi

say "Checking your setup"
command -v git >/dev/null 2>&1 || die "git isn't installed. See the course setup guide."
ok "git"
gh auth status >/dev/null 2>&1 || die "You are not signed in. Run:  gh student login"
ME=$(gh api user --jq .login 2>/dev/null) || die "Couldn't reach GitHub. Check your internet."
ok "signed in as $ME"
gh student --help >/dev/null 2>&1 || {
  printf '  setting up the student tools...\n'
  gh extension install foundation50/gh-student >/dev/null 2>&1 || die "Couldn't install gh-student."
}
ok "student tools"

# find which classroom publishes this assignment (no login needed — it's a static file)
ORG=""; CR=""; MODE="individual"
for pair in $CLASSROOMS; do
  o="${pair%%/*}"; c="${pair##*/}"
  url="https://$(lc "$o").github.io/classroom50/$c/assignments.json"
  doc=$(curl -fsSL "$url" 2>/dev/null) || continue
  printf '%s' "$doc" | grep -q "\"slug\": \"$SLUG\"" || continue
  ORG="$o"; CR="$c"
  # "mode" sits a few lines below its slug in the same record
  m=$(printf '%s' "$doc" | grep -A 16 "\"slug\": \"$SLUG\"" | grep -m1 '"mode"' \
       | sed 's/.*"mode"[^"]*"\([^"]*\)".*/\1/')
  [ -n "$m" ] && MODE="$m"
  break
done
[ -z "$ORG" ] && die "No assignment called '$SLUG'. Check the spelling against what your instructor posted."
ok "found $SLUG"

PARTNER=""
if [ "$MODE" = "group" ]; then
  say "Who are you working with today?"
  printf '  Partner'"'"'s GitHub username (press Enter if working alone): '
  if ! { read -r PARTNER </dev/tty; } 2>/dev/null; then read -r PARTNER || PARTNER=""; fi
  # tolerate "@name", a profile URL, or stray spaces
  PARTNER="$(printf '%s' "${PARTNER:-}" | tr -d '[:space:]' | sed 's|.*/||; s|^@||')"
  if [ -n "$PARTNER" ]; then
    gh api "users/$PARTNER" --jq .login >/dev/null 2>&1 \
      || die "There's no GitHub user called '$PARTNER'. That's their username, not their real name."
    [ "$(lc "$PARTNER")" = "$(lc "$ME")" ] && die "That's your own username — enter your partner's."
    ok "partner: $PARTNER"
  fi
else
  ok "this one is individual work — no partner needed"
fi

MINE="$ORG/$CR-$SLUG-$(lc "$ME")"
THEIRS=""; [ -n "$PARTNER" ] && THEIRS="$ORG/$CR-$SLUG-$(lc "$PARTNER")"

invite_id() {   # id of our pending invitation to repo $1, if any
  gh api user/repository_invitations --paginate \
    --jq ".[] | select(.repository.full_name == \"$1\") | .id" 2>/dev/null | head -1
}

have_access() { gh api "repos/$1/collaborators/$ME" --silent 2>/dev/null; }

join_repo() {   # accept our invitation to $1; a private repo is invisible until we do
  have_access "$1" && return 0
  printf '  getting you access...\n'
  local id
  for _ in 1 2 3 4 5 6; do
    id="$(invite_id "$1")"
    if [ -n "$id" ]; then
      gh api -X PATCH "user/repository_invitations/$id" --silent 2>/dev/null && return 0
    fi
    have_access "$1" && return 0
    sleep 3
  done
  return 1
}

# Has our partner already founded the team repo? A pending invitation proves it
# even though the repo itself is still invisible to us.
partner_started() {
  [ -z "$THEIRS" ] && return 1
  [ -n "$(invite_id "$THEIRS")" ] && return 0
  gh api "repos/$THEIRS" --silent 2>/dev/null
}

created_at() { gh api "repos/$1" --jq .created_at 2>/dev/null; }

# Capture first: `cmd | grep -q` can SIGPIPE cmd, and pipefail turns that into
# a false negative.
auth_scopes() { gh auth status --active 2>&1; }
has_accept_scope() { printf '%s' "$(auth_scopes)" | grep -q "admin:org"; }

require_accept_scope() {   # only STARTING a repo needs this; joining one doesn't
  has_accept_scope && return 0
  say "One more sign-in step (first time only)"
  printf '  Starting a lab repo needs one more GitHub permission.\n'
  printf '  A browser window will open — approve it, then this keeps going.\n\n'
  gh student login || die "Sign-in didn't finish. Run this yourself, then try again:  gh student login"
  has_accept_scope || die "Still missing a permission. Run:  gh student login"
  ok "permissions granted"
}

say "Setting up"
M=0
gh api "repos/$MINE" --silent 2>/dev/null && M=1

if [ "$M" = 0 ] && partner_started; then
  # Partner got here first — join them, no new repo.
  REPO="$THEIRS"
  ok "$PARTNER started this one — joining their repo"
  join_repo "$REPO" || die "No invitation from $PARTNER yet. Wait a few seconds and run this again."
  ok "you have access"
else
  if [ "$M" = 1 ]; then
    REPO="$MINE"; ok "picking up where you left off"
  else
    REPO="$MINE"
    require_accept_scope
    if ! ACCEPT_ERR="$(gh student accept "$ORG" "$CR" "$SLUG" 2>&1)"; then
      [ -n "$ACCEPT_ERR" ] && printf '%s\n' "  $ACCEPT_ERR" >&2
      die "Couldn't start '$SLUG'. If the message above mentions an invitation, accept yours at github.com/$ORG — otherwise show this to your instructor."
    fi
    if [ "$MODE" = "group" ]; then ok "started your team's repo"; else ok "started your repo"; fi
  fi

  # Your partner may have started at the same moment. Re-check, and if you both
  # did, the repo that was actually created FIRST wins. Both of you run this
  # same check and reach the same answer.
  if partner_started; then
    join_repo "$THEIRS" >/dev/null 2>&1
    mine_at=$(created_at "$MINE"); theirs_at=$(created_at "$THEIRS")
    if [ -n "$theirs_at" ] && [ -n "$mine_at" ] && [ "$theirs_at" \< "$mine_at" ]; then
      bad "You and $PARTNER started at the same moment — theirs came first."
      printf '  Switching to their repo so your work stays together.\n'
      REPO="$THEIRS"
      have_access "$REPO" || die "Couldn't get access to $PARTNER's repo. Tell your instructor."
      ok "joined $PARTNER's repo"
      printf '  (Your instructor will clean up the spare one — don'"'"'t worry about it.)\n'
    else
      ok "you and $PARTNER started together — yours came first, so it's the one you'll both use"
    fi
  fi
fi

if [ -n "$PARTNER" ] && [ "$REPO" = "$MINE" ]; then
  if gh api "repos/$REPO/collaborators/$PARTNER" --silent 2>/dev/null; then ok "$PARTNER already has access"
  else
    gh student invite "$REPO" "$PARTNER" >/dev/null 2>&1 \
      && ok "added $PARTNER — they just run the same command" \
      || bad "Couldn't add $PARTNER — are they enrolled? Tell your instructor."
  fi
fi

NAME="$(basename "$REPO")"
COURSE="$(course_dir)"

# Already have this one somewhere? Use it. Downloading a second copy is worse
# than downloading none — work goes into one copy and gets pushed from neither.
find_existing() {
  local p hit
  for p in "$COURSE/$NAME" "$PWD/$NAME" "$HOME/$NAME" "$HOME/Desktop/$NAME" "$HOME/Documents/$NAME"; do
    case "$p" in /"$NAME") continue ;; esac      # COURSE empty -> bogus path
    [ -d "$p/.git" ] && { (cd "$p" && pwd); return 0; }
  done
  hit="$(find "$HOME" -maxdepth 3 -type d -name "$NAME" -not -path "*/.*" \
           -not -path "$HOME/Library/*" -print -quit 2>/dev/null)"
  [ -n "$hit" ] && [ -d "$hit/.git" ] && { printf '%s\n' "$hit"; return 0; }
  return 1
}

say "Getting the code"
DIR="$(find_existing)" || DIR=""

if [ -n "$DIR" ]; then
  (cd "$DIR" && git pull --ff-only >/dev/null 2>&1) && ok "updated to the latest" || bad "couldn't update — ask a TA"
  ok "using the copy you already have: $DIR"
else
  if [ -n "$COURSE" ] && [ -d "$COURSE" ]; then DIR="$COURSE/$NAME"
  else
    DIR="$NAME"
    NO_COURSE_DIR=1
  fi
  if ! CLONE_ERR="$(gh repo clone "$REPO" "$DIR" 2>&1)"; then
    [ -n "$CLONE_ERR" ] && printf '%s\n' "  $CLONE_ERR" >&2
    die "Couldn't download the code. The message above says why."
  fi
  ok "downloaded to $(cd "$DIR" && pwd)"
  if [ "${NO_COURSE_DIR:-0}" = 1 ]; then
    printf '  Tip: cd to your course folder and run  gh %s --here  once, and\n' "$CMD"
    printf '       assignments will always land there instead of wherever you are.\n'
  fi
fi

# Keep one editor window for the whole course. The workspace file lists every
# assignment folder sitting next to this one, so opening it shows them all in a
# single window instead of one window per assignment. Rebuilt from what's
# actually on disk each time — no JSON parsing, and it repairs itself if the
# file gets mangled.
WS_DIR="$(cd "$(dirname "$DIR")" && pwd)"
WS="$WS_DIR/RAIK183H.code-workspace"

build_workspace() {
  local d n first=1 tmp="$WS.tmp"
  {
    printf '{\n  "folders": [\n'
    for d in "$WS_DIR"/*/; do
      [ -d "$d" ] || continue          # no subfolders: glob stayed literal
      [ -d "$d.git" ] || continue      # only real assignment repos
      n="$(basename "$d")"
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    { "path": "%s" }' "$n"
    done
    printf '\n  ],\n  "settings": {}\n}\n'
  } > "$tmp" 2>/dev/null && mv "$tmp" "$WS" || { rm -f "$tmp"; return 1; }
  [ "$first" -eq 1 ] && { rm -f "$WS"; return 1; }   # nothing to list
  return 0
}

WS_OK=0
build_workspace && WS_OK=1

EDITOR=""
if   command -v cursor >/dev/null 2>&1; then EDITOR=cursor
elif command -v code   >/dev/null 2>&1; then EDITOR=code
fi

install_extensions() {
  [ -z "$EDITOR" ] && return 0
  local have missing="" vsix
  have="$("$EDITOR" --list-extensions 2>/dev/null | tr 'A-Z' 'a-z')" || return 0
  for e in $EXTENSIONS; do
    printf '%s\n' "$have" | grep -qx "$(lc "$e")" || missing="$missing $e"
  done
  printf '%s\n' "$have" | grep -qx "$CHECKSTYLE_ID" || missing="$missing $CHECKSTYLE_ID"
  [ -z "$missing" ] && { ok "course extensions"; return 0; }

  printf '  installing course extensions (first time only, ~1 min)...\n'
  for e in $missing; do
    if [ "$e" = "$CHECKSTYLE_ID" ]; then
      vsix="${TMPDIR:-/tmp}/CheckstyleForJava.vsix"
      curl -fsSL "$CHECKSTYLE_VSIX" -o "$vsix" 2>/dev/null \
        && "$EDITOR" --install-extension "$vsix" --force >/dev/null 2>&1 \
        && ok "checkstyle (course linter)" \
        || bad "couldn't install Checkstyle — see the setup guide to add it by hand"
    else
      "$EDITOR" --install-extension "$e" --force >/dev/null 2>&1 \
        && ok "${e#*.}" || bad "couldn't install $e — install it from the Extensions panel"
    fi
  done
}

say "Checking your editor"
if [ -n "$EDITOR" ]; then install_extensions; else
  bad "No 'cursor' command, so I can't set up your editor extensions."
  printf "  In Cursor: Cmd/Ctrl+Shift+P, run \"Install 'cursor' command\", then run this again.\n"
fi

say "Opening"
if [ -n "$EDITOR" ]; then
  TARGET="$DIR"; WHAT="opened in $EDITOR"
  if [ "$WS_OK" = 1 ]; then
    TARGET="$WS"
    WHAT="opened your course workspace — every assignment is in this one window"
  fi
  if "$EDITOR" "$TARGET" >/dev/null 2>&1; then ok "$WHAT"
  else
    bad "Couldn't open your editor automatically."
    if [ "$WS_OK" = 1 ]; then
      printf "  Open this file yourself (File > Open):  %s\n" "$WS"
    else
      printf "  Open this folder yourself:  %s\n" "$(cd "$DIR" && pwd)"
    fi
  fi
else
  bad "Couldn't open your editor automatically."
  printf "  Open this folder yourself:  %s\n" "$(cd "$DIR" && pwd)"
fi
printf '\n  \033[1mReady.\033[0m Your work goes in %s/\n' "$DIR"
printf '  To turn it in: commit and push from the Source Control panel.\n\n'
